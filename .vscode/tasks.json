{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: Install All Dependencies",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/setup.sh",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Reset: Clean Environment",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/reset.sh",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Lint Backend (Ruff Check)",
      "type": "shell",
      "command": "cd backend && source venv/bin/activate && ruff check .",
      "windows": {
        "command": "cd backend && .\\venv\\Scripts\\activate && ruff check ."
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": {
        "owner": "ruff",
        "fileLocation": ["relative", "${workspaceFolder}/backend"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+):\\s+(.+)\\s+\\[(.+)\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      },
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Lint Backend (Ruff Fix)",
      "type": "shell",
      "command": "cd backend && source venv/bin/activate && ruff check --fix .",
      "windows": {
        "command": "cd backend && .\\venv\\Scripts\\activate && ruff check --fix ."
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Format Backend (Ruff)",
      "type": "shell",
      "command": "cd backend && source venv/bin/activate && ruff format .",
      "windows": {
        "command": "cd backend && .\\venv\\Scripts\\activate && ruff format ."
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Coverage: Generate HTML Report",
      "type": "shell",
      "command": "cd backend && source .venv/bin/activate && rm -rf coverage_report && python -m pytest --cov=app --cov-report=html:coverage_report && echo \"Report generated at backend/coverage_report/index.html\"",
      "windows": {
        "command": "cd backend && .\\.venv\\Scripts\\activate && if exist coverage_report rmdir /s /q coverage_report && python -m pytest --cov=app --cov-report=html:coverage_report && echo Report saved to coverage_report\\index.html"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
